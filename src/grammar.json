    "word": {
      "type": "PATTERN",
      "value": "[_\\p{Alphabetic}\\p{Extended_Pictographic}][_\\p{Alphabetic}\\p{Nd}\\p{Extended_Pictographic}]*",
      "flags": "u"
    },
    "definition": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "import_composed"
        },
        {
          "type": "SYMBOL",
          "name": "trait_composed"
        },
        {
          "type": "SYMBOL",
          "name": "type_definition_composed"
        },
        {
          "type": "SYMBOL",
          "name": "function_definition_composed"
        }
      ]
    },
    "function_arg": {
