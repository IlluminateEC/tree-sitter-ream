            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "type_definition_composed"
              },
              {
                "type": "SYMBOL",
                "name": "function_definition_composed"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "type_composed": {
      "type": "SYMBOL",
      "name": "type_union"
    },
    "type_definition_composed": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "type"
