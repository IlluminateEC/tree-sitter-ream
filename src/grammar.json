    "comment": {
      "type": "PATTERN",
      "value": "\\/\\/[^\\n]*[^\\n]*"
    },
    "doc_comment": {
      "type": "PATTERN",
      "value": "\\/\\/\\/[^\\n]*[^\\n]*"
    },
    "superdoc_comment": {
      "type": "PATTERN",
      "value": "\\/![^\\n]*[^\\n]*"
    },
    "atom": {
      "type": "PATTERN",
      "value": ":[_\\p{Alphabetic}\\p{Nd}\\p{Extended_Pictographic}]+",
      "flags": "u"
    },
    "identifier": {
