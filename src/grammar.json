    },
    "type_union": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "type_intersection"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "|"
                },
                {
                  "type": "SYMBOL",
                  "name": "type_union"
                }
              ]
            },
