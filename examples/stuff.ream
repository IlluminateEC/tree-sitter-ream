import std/io
import std/string
import std/async as async


type Status
    = :online
    | :idle
    | :offline

type never = Never

type Option[T]
    = { :some, T }
    | { :none }

type User = #{
    name: String,
    status: Status,
    display_name: Option[String]
}

fn has_display_name(user: User) -> bool {
    match user.display_name {
		{ :some, _ } => true,
        { :none } => false
    }
}

fn square(x: Int, y: Int) -> Int {
	x * y
}

fn gwah() -> String {
	"awa!\n"
}
